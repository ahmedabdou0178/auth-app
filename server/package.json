    "@types/supertest": "7.2.1",
    "ioredis-mock": "8.13.1",
    "jest": "30.5.2",
    "mongodb-memory-server": "11.3.0",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15"
  }
