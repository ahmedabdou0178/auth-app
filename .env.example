# Single repo-root env file read by the API, Vite (envDir) and docker compose.
# Copy to .env and replace every value marked "replace-me".

# --- API ---
NODE_ENV=development
PORT=3000
# Host access to the compose Mongo (`docker compose up -d mongo`): the app user, with the same
# password as MONGO_APP_PASSWORD below. directConnection: the replica set advertises `mongo:27017`.
MONGODB_URI=mongodb://auth_app:replace-me@localhost:27017/auth?directConnection=true&authSource=auth
SESSION_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173
# Plain HTTP on localhost only; production refuses false (unless CORS_ORIGIN is localhost)
COOKIE_SECURE=false
LOG_LEVEL=info
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=5
# Failed sign-ins per email + client IP before that IP is locked out of the email
LOCKOUT_MAX_ATTEMPTS=5
# Failed sign-ins per email across all IPs before every IP is locked out (distributed attacks)
LOCKOUT_ACCOUNT_MAX_ATTEMPTS=100
LOCKOUT_DURATION=15m
TRUST_PROXY=1
# Optional locally (counters stay in memory); required in production
# REDIS_URL=redis://localhost:6379

# --- Docker Compose only (no defaults; generate with: openssl rand -hex 24) ---
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=replace-me
MONGO_APP_USERNAME=auth_app
MONGO_APP_PASSWORD=replace-me
REDIS_PASSWORD=replace-me

# --- Docker Compose: resource limits and log rotation (optional; defaults shown) ---
# API_MEMORY_LIMIT=512m
# API_CPU_LIMIT=1.0
# API_UV_THREADPOOL_SIZE=4   # concurrent argon2 hashes (~64 MiB each)
# API_HEAP_MB=256
# MONGO_MEMORY_LIMIT=1g
# MONGO_CPU_LIMIT=1.0
# MONGO_CACHE_GB=0.25
# REDIS_MEMORY_LIMIT=64m
# REDIS_CPU_LIMIT=0.25
# REDIS_MAXMEMORY=48mb
# WEB_MEMORY_LIMIT=64m
# WEB_CPU_LIMIT=0.5
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=5

# --- Production overlay only (docker-compose.prod.yml) ---
# WEB_BIND=127.0.0.1   # private address the TLS load balancer connects to; never 0.0.0.0
# WEB_PORT=8080

# --- Web (build/dev time) ---
VITE_API_URL=http://localhost:3000/api
